{
	"compilerOptions": {
		"allowJs": false,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": [
		"frontend/**/*.ts",
		"handlers/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"playwright.config.ts",
		"vitest.config.ts"
	]
}
